# Required
GOOGLE_API_KEY=your_google_api_key

# Models (defaults shown)
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001

# Vector store: set PINECONE_API_KEY to use Pinecone (recommended). Leave empty to use a built-in local store.
PINECONE_API_KEY=
PINECONE_INDEX=chat-pdf
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Optional tuning
# Origins allowed to call the API when the frontend is hosted separately (comma-separated)
CORS_ORIGINS=http://localhost:5173
DATA_DIR=./data
MAX_UPLOAD_MB=25
TOP_K=6
